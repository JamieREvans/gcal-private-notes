{
  "name": "gcal-notes",
  "description": "Private notes on your Google Calendar events. Never added to the event or shared with guests.",
  "version": "0.3.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": "github:JamieREvans/gcal-private-notes",
  "type": "module",
  "scripts": {
    "dev": "npm run build:editor && wxt",
    "build": "npm run build:editor && wxt build",
    "zip": "npm run build:editor && wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "icons": "node scripts/icons.mjs",
    "e2e": "node test/e2e/run.mjs",
    "store-assets": "node scripts/store-assets.mjs",
    "demo-video": "node scripts/demo-video.mjs",
    "build:editor": "vite build --config vite.editor.config.ts --logLevel warn"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-blockquote": "^3.32.0",
    "@tiptap/extension-bold": "^3.32.0",
    "@tiptap/extension-code": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-italic": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-strike": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "extpay": "^3.1.2",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "happy-dom": "^21.0.3",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
